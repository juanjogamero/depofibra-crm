# Copiar a .env.vps (no subir a Git). No introducir claves API ni datos de clientes.
# DNS A/AAAA debe apuntar al VPS; ejemplo NO es un dominio configurado.
CRM_DOMAIN=crm-pruebas.example.invalid
CRM_ACME_EMAIL=admin@example.invalid
CRM_GATE_USER=cambiar_usuario
# Hash bcrypt obtenido de: docker run --rm -it caddy:2.10-alpine caddy hash-password
# IMPORTANTE: pegar el hash completo entre comillas simples por los caracteres $.
CRM_GATE_PASSWORD_HASH='$2a$14$REEMPLAZAR_POR_HASH_SEGURO_GENERADO_LOCALMENTE'
